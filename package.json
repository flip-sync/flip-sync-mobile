{
  "name": "flipsync",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "bundle-icons": "node script/icon-bundler.js",
    "test": "jest --watchAll",
    "eas:init": "npx eas-cli init",
    "eas:build:android": "npx eas-cli build --platform android --profile production",
    "eas:build:ios": "npx eas-cli build --platform ios --profile production",
    "eas:build:all": "npx eas-cli build --platform all --profile production",
    "eas:build:preview:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:dev:android": "npx eas-cli build --platform android --profile development",
    "eas:credentials:android": "npx eas-cli credentials --platform android",
    "eas:credentials:ios": "npx eas-cli credentials --platform ios",
    "eas:metadata:pull": "npx eas-cli metadata:pull",
    "eas:metadata:push": "npx eas-cli metadata:push",
    "eas:submit:android:internal": "npx eas-cli submit --platform android --profile internal --latest",
    "eas:submit:android:production": "npx eas-cli submit --platform android --profile production --latest",
    "eas:submit:ios:production": "npx eas-cli submit --platform ios --profile production --latest",
    "eas:submit:all:production": "npx eas-cli submit --platform all --profile production --latest"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.100.8",
    "@types/react-native-draggable-flatlist": "^2.0.0",
    "axios": "^1.15.2",
    "dayjs": "^1.11.20",
    "expo": "~55.0.20",
    "expo-constants": "~55.0.15",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.6",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linking": "~55.0.14",
    "expo-network": "~55.0.13",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-modal": "^13.0.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
